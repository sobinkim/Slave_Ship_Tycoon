<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="../Shared/Styles/HarborTheme.uss" />
    <ui:Style src="RecruitmentScreen.uss" />
    <ui:VisualElement class="harbor-root recruitment-root" picking-mode="Ignore">
        <ui:VisualElement name="shopPanel" class="recruitment-panel">
            <ui:VisualElement class="screen-header">
                <ui:Label text="선착장 · 함선 모집" class="screen-title" />
                <ui:Button name="closeButton" text="닫기" class="harbor-button close-button" />
            </ui:VisualElement>
            <ui:ScrollView class="harbor-scroll recruitment-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden">
                <ui:VisualElement class="recruitment-content">
                    <ui:VisualElement class="recruitment-cards">
                        <ui:VisualElement class="recruitment-card">
                            <ui:VisualElement class="recruitment-hero">
                                <ui:VisualElement name="recruitmentIcon" class="recruitment-card-icon" />
                                <ui:VisualElement class="recruitment-copy">
                                    <ui:Label text="호위선 모집" class="recruitment-category" />
                                    <ui:Label text="새 호위선을 모집해 함대를 꾸리세요." class="recruitment-card-title" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement class="action-row recruitment-actions">
                                <ui:Button name="singleButton" class="harbor-button recruitment-button">
                                    <ui:Label text="1회 모집" picking-mode="Ignore" />
                                    <ui:Label name="singleCost" class="recruitment-cost" picking-mode="Ignore" />
                                </ui:Button>
                                <ui:Button name="multiButton" class="harbor-button primary-button recruitment-button">
                                    <ui:Label name="multiTitle" text="15회 모집" picking-mode="Ignore" />
                                    <ui:Label name="multiCost" class="recruitment-cost" picking-mode="Ignore" />
                                </ui:Button>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:Label name="statusLabel" class="status" />
                        <ui:Button name="formationButton" text="함대 편성으로 이동" class="harbor-button primary-button formation-button" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:ScrollView>
        </ui:VisualElement>
        <ui:VisualElement name="resultPanel" class="modal hidden">
            <ui:Label text="새 호위선 입항" class="modal-title" />
            <ui:Label name="resultSummary" class="modal-summary" />
            <ui:ScrollView name="resultScroll" class="harbor-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden">
                <ui:VisualElement name="resultGrid" class="card-grid recruitment-result-grid" />
            </ui:ScrollView>
            <ui:VisualElement class="action-row">
                <ui:Button name="skipButton" text="연출 건너뛰기" class="harbor-button" />
                <ui:Button name="confirmButton" text="확인" class="harbor-button" />
                <ui:Button name="repeatButton" class="harbor-button primary-button">
                    <ui:Label name="repeatTitle" text="다시 모집" picking-mode="Ignore" />
                    <ui:Label name="repeatCost" class="recruitment-cost" picking-mode="Ignore" />
                </ui:Button>
                <ui:Button name="resultFormationButton" text="함대 편성" class="harbor-button" />
            </ui:VisualElement>
            <ui:VisualElement name="resultFlash" class="recruitment-screen-flash" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
