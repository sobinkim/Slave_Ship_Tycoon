.recruitment-root { flex-grow: 1; }
.recruitment-panel {
    position: absolute; left: 0; right: 0; top: 60.6%; bottom: 132px;
    padding: 24px 24px 8px;

    overflow: hidden;
}
.recruitment-panel > .screen-header { height: 72px; margin-bottom: var(--ui-space-sm); }
.recruitment-panel .screen-title { min-width: 0; white-space: normal; font-size: var(--ui-font-title); }
.recruitment-panel .close-button { flex-shrink: 0; margin: 0 0 0 16px; }
.recruitment-scroll { flex-basis: 0; }
.recruitment-scroll > .unity-scroll-view__vertical-scroller { width: 12px; margin-left: 8px; }
.recruitment-content { flex-direction: column; align-items: center; justify-content: center; min-height: 100%; padding: 8px 0; }
.recruitment-cards { width: 84%; min-width: 0; align-self: center; }
.recruitment-card { padding: 0; align-items: stretch; }
.recruitment-hero { min-height: 144px; flex-direction: row; align-items: center; margin-bottom: 12px; }
.recruitment-card-icon { width: 144px; height: 120px; flex-shrink: 0; -unity-background-scale-mode: scale-to-fit; margin: 0 24px 0 0; }
.recruitment-copy { flex-grow: 1; flex-basis: 0; min-width: 0; }
.recruitment-category { font-size: var(--ui-font-description); margin: 0 0 4px; padding: 0; color: var(--ui-text-secondary); }
.recruitment-card-title { min-width: 0; white-space: normal; font-size: var(--ui-font-item); -unity-text-align: middle-left; margin: 0; padding: 0; }
.recruitment-actions { width: 100%; margin-top: 4px; }
.recruitment-actions > .recruitment-button { flex-grow: 1; flex-basis: 0; height: 96px; min-height: 96px; min-width: 0; padding: 8px; justify-content: center; align-items: stretch; }
.recruitment-button > Label { min-width: 0; margin: 0; padding: 0; font-size: var(--ui-font-body); -unity-text-align: middle-center; white-space: normal; }
.recruitment-button > .recruitment-cost {  margin-top: 8px; font-size: var(--ui-font-value); }
.recruitment-cards > .status { width: 100%; min-height: 0; min-width: 0; font-size: var(--ui-font-caption); -unity-text-align: middle-center; margin: 4px 0; padding: 0; white-space: normal; }
.recruitment-cards > .harbor-button { height: 72px; min-height: 72px; margin: 4px 0 0; padding: 0 8px; font-size: var(--ui-font-body); }
.recruitment-cards > .formation-button { width: 100%; margin-top: 4px; color: #FFFFFF; }
.recruitment-result-grid .ship-card { width: 23.8%; height: 280px; }
.recruitment-reward-card.recruitment-card-muted { opacity: 0.4; }
.recruitment-card-flash, .recruitment-card-ring { position: absolute; left: 0; right: 0; top: 0; bottom: 0;  opacity: 0; }
.recruitment-screen-flash { position: absolute; left: 0; right: 0; top: 0; bottom: 0;  opacity: 0; }

.recruitment-root > .modal > .action-row > .harbor-button { min-height: 120px; height: 120px; }
.recruitment-root > .modal > .action-row > .harbor-button > Label { white-space: normal; -unity-text-align: middle-center; }
.recruitment-root > .modal > .action-row > .harbor-button > .recruitment-cost { margin-top: 6px; font-size: var(--ui-font-description); }
