<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement class="cargo-card">
        <ui:VisualElement class="cargo-card-heading">
            <ui:VisualElement name="icon" class="cargo-icon" />
            <ui:VisualElement class="cargo-card-copy">
                <ui:Label name="cargoName" class="cargo-name" />
                <ui:Label name="amount" class="cargo-amount" />
                <ui:Label name="weight" class="small-text" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Label name="rewards" class="cargo-rewards" />
        <ui:VisualElement class="cargo-actions">
            <ui:Button name="unloadButton" text="−1" class="harbor-button" />
            <ui:Button name="loadButton" text="적재 +1" class="harbor-button primary-button" />
        </ui:VisualElement>
        <ui:Button name="removeButton" text="이 화물 비우기" class="harbor-button cargo-remove" />
    </ui:VisualElement>
</ui:UXML>