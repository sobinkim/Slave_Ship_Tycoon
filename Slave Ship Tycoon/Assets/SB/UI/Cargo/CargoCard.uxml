<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement class="cargo-card">
        <ui:VisualElement class="cargo-card-heading">
            <ui:VisualElement name="icon" class="cargo-icon" picking-mode="Ignore" />
            <ui:VisualElement class="cargo-card-copy" picking-mode="Ignore">
                <ui:Label name="cargoName" class="cargo-name" />
                <ui:Label name="weight" class="cargo-unit-weight" />
            </ui:VisualElement>
            <ui:VisualElement class="cargo-actions">
                <ui:Button name="unloadButton" text="−" class="harbor-button cargo-stepper" />
                <ui:Label name="amount" text="0" class="cargo-amount" picking-mode="Ignore" />
                <ui:Button name="loadButton" text="+" class="harbor-button cargo-stepper" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="rewards" class="cargo-rewards" tooltip="화물 1개당 기본 보상" />
    </ui:VisualElement>
</ui:UXML>
