.cargo-screen { padding: 26px; }
.cargo-balances { font-size: 25px; color: var(--color-accent); margin-bottom: 14px; }
.cargo-section { flex-grow: 1; flex-basis: 0; min-height: 0; background-color: var(--color-surface-raised); padding: 14px; }
.catalog-section { margin-top: 16px; }
.cargo-heading { flex-direction: row; justify-content: space-between; align-items: center; }
.cargo-heading > .section-title { margin-top: 0; }
.capacity-text { font-size: 28px; color: var(--color-accent); }
.capacity-track { height: 8px; margin-bottom: 14px; background-color: var(--color-border); }
.capacity-fill { height: 100%; background-color: var(--color-action-hover); }
.capacity-fill.is-overloaded { background-color: var(--color-status-danger); }
.cargo-grid { flex-direction: row; flex-wrap: wrap; align-content: flex-start; }
.cargo-card { width: 48%; flex-shrink: 0; min-height: 328px; margin: 1%; padding: 14px; background-color: var(--color-surface-inset); border-width: 2px; border-color: var(--color-border); border-radius: 8px; }
.cargo-card-heading { flex-direction: row; }
.cargo-icon { width: 104px; height: 104px; margin-right: 12px; -unity-background-scale-mode: scale-to-fit; }
.cargo-card-copy { flex-grow: 1; flex-basis: 0; }
.cargo-name { font-size: 28px; white-space: normal; -unity-font-style: bold; }
.cargo-amount { font-size: 25px; color: var(--color-accent); }
.small-text { color: var(--color-text-secondary); font-size: 22px; white-space: normal; }
.cargo-rewards { min-height: 48px; font-size: 23px; color: var(--color-accent); white-space: normal; margin: 8px 0; }
.cargo-actions { flex-direction: row; }
.cargo-actions > .harbor-button { flex-grow: 1; flex-basis: 0; height: 64px; min-height: 64px; padding: 6px; font-size: 24px; }
.cargo-remove { height: 52px; min-height: 52px; padding: 4px; font-size: 22px; color: var(--color-text-secondary); }
.cargo-empty { width: 23%; height: 140px; margin: 1%; font-size: 45px; min-height: 140px; flex-shrink: 0; }
.reward-preview { padding: 14px 18px; margin-top: 14px; background-color: var(--color-surface-inset); }
.reward-values { color: var(--color-accent); font-size: 28px; white-space: normal; margin-top: 8px; }
.cargo-screen > .status { min-height: 50px; }
.cargo-screen > .harbor-button { flex-shrink: 0; }

.cargo-slot, .cargo-empty { width: 23%; height: 140px; min-height: 140px; max-height: 140px; flex-shrink: 0; margin: 1%; }
.cargo-slot { padding: 6px 8px 32px 8px; border-width: 2px; border-radius: 6px; background-color: var(--color-surface-inset); }
.cargo-slot-icon { width: 100%; height: 100%; -unity-background-scale-mode: scale-to-fit; }
.cargo-slot-name { position: absolute; bottom: 4px; left: 4px; right: 4px; font-size: 21px; -unity-text-align: middle-center; margin: 0; padding: 0; }
.cargo-slot-amount { position: absolute; top: 4px; right: 4px; font-size: 22px; -unity-font-style: bold; background-color: var(--color-surface-primary); color: var(--color-accent); margin: 0; padding: 2px 6px; }
.cargo-slot-hint { font-size: 20px; margin: 0 0 8px 0; }
.cargo-detail-overlay { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: var(--color-surface-overlay); justify-content: center; padding: 36px; }
.cargo-detail-panel { background-color: var(--color-surface-primary); border-width: 2px; border-color: var(--color-border); border-radius: 8px; padding: 24px; }
.cargo-card.is-detail-card { width: 100%; margin: 0; min-height: 390px; }
.is-detail-card .cargo-actions > .harbor-button { height: 80px; min-height: 80px; font-size: 28px; }
.is-detail-card .cargo-remove { height: 70px; min-height: 70px; font-size: 26px; }
