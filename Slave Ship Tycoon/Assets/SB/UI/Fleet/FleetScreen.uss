.fleet-screen {
    --fleet-selection-surface: #656565;
    --fleet-details-surface: #383838;
    --fleet-details-border: #585858;
    --fleet-target-surface: #4E4E4E;
    --fleet-target-border: #B8B8B8;
    padding: 40px;
}
.fleet-screen > .screen-header { height: 80px; margin-bottom: 16px; }
.fleet-screen .close-button { margin: 0; }
.fleet-screen > .action-row { margin-top: 24px; }
.fleet-screen > .action-row > .harbor-button { margin: 0; }
.fleet-screen > .action-row > .fleet-merge-button { margin-right: 16px; }
.formation-heading { flex-direction: row; align-items: center; height: 64px; flex-shrink: 0; margin-bottom: 16px; }
.formation-heading > .side-title { flex-grow: 1; min-width: 0; margin: 0; -unity-text-align: middle-left; }
.formation-side > .side-title { height: 64px; flex-shrink: 0; margin: 0 0 16px; -unity-text-align: middle-center; }
.formation-clear-button { width: 216px; height: 56px; min-height: 56px; padding: 8px; margin: 0; font-size: var(--ui-font-caption); }
.fleet-hint { margin: 24px 0 16px; font-size: var(--ui-font-caption); }
.formation-comparison { flex-direction: row; height: 650px; flex-shrink: 0; }
.formation-side { flex-grow: 1; flex-basis: 0; min-width: 0; }
.side-title { font-size: var(--ui-font-item); margin-bottom: var(--ui-space-sm); -unity-text-align: middle-center; }
.formation-columns { flex-direction: row; flex-grow: 1; min-height: 0; }
.formation-column { flex-grow: 1; flex-basis: 0; min-width: 0; margin: 3px; }
.column-title { -unity-text-align: middle-center; font-size: var(--ui-font-description); height: 40px; flex-shrink: 0; margin: 0; padding: 0; }
.formation-cells { flex-grow: 1; }
.formation-slot {
    flex-grow: 1; flex-basis: 0; min-height: 0; margin: 4px 0;
    padding: 6px;

}
.formation-slot.grade-common { border-color: var(--color-grade-common); }
.formation-slot.grade-uncommon { border-color: var(--color-grade-uncommon); }
.formation-slot.grade-rare { border-color: var(--color-grade-rare); }
.formation-slot.grade-epic { border-color: var(--color-grade-epic); }
.formation-slot.grade-legendary { border-color: var(--color-grade-legendary); }
.formation-slot.is-selected.grade-common { border-color: var(--color-grade-common); }
.formation-slot.is-selected.grade-uncommon { border-color: var(--color-grade-uncommon); }
.formation-slot.is-selected.grade-rare { border-color: var(--color-grade-rare); }
.formation-slot.is-selected.grade-epic { border-color: var(--color-grade-epic); }
.formation-slot.is-selected.grade-legendary { border-color: var(--color-grade-legendary); }
.formation-slot .ship-icon { min-height: 20px; }
.formation-slot .ship-name { font-size: 24px; }
.formation-slot .ship-count { font-size: var(--ui-font-description); }
.fleet-inventory-card > .ship-icon {
    width: 160px; height: 160px; min-height: 160px; flex-grow: 0; flex-shrink: 0;
    align-self: center; background-color: #3D3D3D; border-width: 2px;
}
.fleet-inventory-card.grade-common > .ship-icon { border-color: var(--color-grade-common); }
.fleet-inventory-card.grade-uncommon > .ship-icon { border-color: var(--color-grade-uncommon); }
.fleet-inventory-card.grade-rare > .ship-icon { border-color: var(--color-grade-rare); }
.fleet-inventory-card.grade-epic > .ship-icon { border-color: var(--color-grade-epic); }
.fleet-inventory-card.grade-legendary > .ship-icon { border-color: var(--color-grade-legendary); }
.comparison-arrow { width: 38px; flex-shrink: 0; -unity-text-align: middle-center;  font-size: 38px; }
.enemy-column {    padding: 8px; }
.enemy-marker { flex-grow: 1; flex-basis: 0; -unity-text-align: middle-center; font-size: 32px; color: var(--ui-text-secondary); }
.attack-details {
    padding: var(--ui-space-md); margin-top: var(--ui-space-md); min-height: 160px; flex-shrink: 0;
    background-color: var(--fleet-details-surface);
    border-width: 1px; border-color: var(--fleet-details-border);
}
.attack-name { font-size: var(--ui-font-item); margin: 0; padding: 0; }
.attack-description { font-size: var(--ui-font-description); white-space: normal; margin: 8px 0 0; padding: 0; }


.fleet-inventory-card {
    width: 19.2%; height: 224px; margin: 0.4%; padding: 0;
    --fleet-count-surface: rgba(48, 48, 48, 0.85);
}
.fleet-inventory-card.is-selected { border-width: 0; }
.fleet-inventory-card.is-selected > .ship-icon { background-color: var(--fleet-selection-surface); }
.fleet-inventory-card.is-selected > .ship-selected-mark { display: none; }
.formation-slot.is-selected { background-color: var(--fleet-selection-surface); }
.enemy-column.is-target {
    background-color: var(--fleet-target-surface);
    border-width: 2px; border-color: var(--fleet-target-border);
}
.enemy-column.is-target > .enemy-marker { color: var(--ui-text-primary); }
.fleet-inventory-card .ship-count {
    position: absolute; right: 4px; bottom: 4px;
    margin: 0; padding: 0 4px;
    font-size: var(--ui-font-caption); color: var(--ui-text-primary);
    background-color: var(--fleet-count-surface);
}
