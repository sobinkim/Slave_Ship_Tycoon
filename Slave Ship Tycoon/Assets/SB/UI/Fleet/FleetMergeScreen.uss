.merge-preview { flex-direction: row; height: 270px; flex-shrink: 0; padding: var(--ui-space-md);    }
.merge-preview-side { flex-grow: 1; flex-basis: 0; align-items: stretch; }
.merge-arrow { width: 100px; -unity-text-align: middle-center;  font-size: 60px; }
.material-slots { flex-direction: row; height: 272px; flex-shrink: 0; margin-top: var(--ui-space-md); }
.material-slots > .ship-card { flex-grow: 1; flex-basis: 0; height: auto; width: auto; margin: 8px; }
#resultGrid > .ship-card { width: 31.8%; height: 330px; }

.merge-preview-side > .ship-name { font-size: var(--ui-font-item); }
.material-slots .ship-count { font-size: var(--ui-font-caption); }
