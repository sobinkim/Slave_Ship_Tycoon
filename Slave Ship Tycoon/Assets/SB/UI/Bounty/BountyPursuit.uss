.pursuit-root { position: absolute; top: 0; bottom: 0; left: 0; right: 0; }
.pursuit-hidden { display: none; }
.pursuit-hud { position: absolute; top: 72px; left: 24px; right: 24px; padding: 8px 16px; background-color: #303030; }
.pursuit-heading { flex-direction: row; align-items: center; }
.pursuit-title { flex-grow: 1; font-size: var(--ui-font-body); margin: 0; padding: 0; }
.pursuit-time { font-size: var(--ui-font-description); margin: 0 16px 0 8px; padding: 0; }
.pursuit-retreat { min-height: 56px; height: 56px; min-width: 88px; font-size: var(--ui-font-description); margin: 0; padding: 8px 16px; }
.pursuit-progress-row { flex-direction: row; align-items: center; margin-top: 8px; margin-bottom: 8px; }
.pursuit-track { height: 10px; flex-grow: 1; margin-right: 16px; }
.pursuit-fill { position: absolute; left: 0; top: 0; bottom: 0; width: 0; }
.pursuit-destination { font-size: var(--ui-font-compact); color: var(--ui-text-secondary); margin: 0; padding: 0; }
.pursuit-hint { font-size: var(--ui-font-caption); color: var(--ui-text-secondary); white-space: normal; margin: 0; padding: 0; }
