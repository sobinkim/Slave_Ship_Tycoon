.feedback-root { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.stage-popup { position: absolute; left: 100px; right: 100px; top: 30%; background-color: var(--color-surface-overlay); padding: 28px; border-top-width: 3px; border-bottom-width: 3px; border-color: var(--color-accent); }
.popup-stage { font-size: 28px; color: var(--color-accent); -unity-text-align: middle-center; }
.popup-result { font-size: 36px; white-space: normal; -unity-font-style: bold; -unity-text-align: middle-center; }
.settlement-card { height: 74%; padding: 28px; background-color: var(--color-surface-primary); border-width: var(--border-control-width); border-color: var(--color-border); border-radius: 0; }
.settlement-card.is-settled { border-color: var(--color-accent); }
.settlement-content { flex-grow: 1; flex-basis: 0; min-height: 0; }
.settlement-content > .unity-scroll-view__vertical-scroller { width: 12px; margin-left: 8px; }
.settlement-eyebrow { font-size: 26px; color: var(--color-accent); -unity-text-align: middle-center; margin-bottom: 12px; }
.settlement-goal { padding: 20px; margin-bottom: 18px; background-color: transparent; border-width: 0; border-bottom-width: var(--border-control-width); border-bottom-color: var(--color-border); border-radius: 0; align-items: center; }
.settlement-goal-title { font-size: 27px; color: var(--color-text-secondary); white-space: normal; -unity-text-align: middle-center; }
.settlement-goal-amount { font-size: 64px; color: var(--color-accent); -unity-font-style: bold; margin-top: 8px; margin-bottom: 6px; }
.settlement-goal-caption { font-size: 24px; color: var(--color-text-secondary); }
.settlement-breakdown { margin-bottom: 22px; }
.settlement-breakdown-row { flex-direction: row; justify-content: space-between; padding: 5px 8px; }
.settlement-breakdown-row > Label { font-size: 25px; color: var(--color-text-secondary); }
.settlement-breakdown-row > .settlement-breakdown-value { color: var(--color-text-primary); -unity-font-style: bold; }
.settlement-rewards-title { color: var(--color-text-secondary); font-size: 24px; margin-bottom: 10px; }
.settlement-reward { flex-direction: row; justify-content: space-between; align-items: center; background-color: transparent; padding: 16px 20px; margin-bottom: 10px; border-width: 0; border-bottom-width: var(--border-control-width); border-bottom-color: var(--color-border); border-radius: 0; }
.settlement-reward.is-goal { border-color: var(--color-accent); }
.settlement-reward-name { font-size: 27px; }
.reward-amount { font-size: 36px; color: var(--color-accent); -unity-font-style: bold; }
.settlement-status { font-size: 28px; color: var(--color-accent); -unity-font-style: bold; -unity-text-align: middle-center; margin-top: 8px; }
.settlement-growth-hint { flex-shrink: 0; font-size: 25px; color: var(--color-text-secondary); white-space: normal; -unity-text-align: middle-center; margin-top: 24px; }
.settlement-actions { margin-top: 10px; }
.settlement-close { flex-shrink: 0; margin-top: 8px; height: 68px; min-height: 68px; color: var(--color-text-secondary); }
.stage-fade { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: var(--color-surface-primary); }
