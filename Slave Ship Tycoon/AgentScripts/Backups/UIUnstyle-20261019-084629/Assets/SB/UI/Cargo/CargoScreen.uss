.cargo-screen { padding: 26px; }
.cargo-section { flex-grow: 1; flex-basis: 0; min-height: 0; background-color: transparent; border-top-width: var(--border-control-width); border-top-color: var(--color-border); padding: 14px; }
.selected-section { flex-grow: 0; flex-shrink: 1; flex-basis: auto; }
.selected-section > .harbor-scroll { flex-grow: 0; flex-shrink: 1; }
.catalog-section { margin-top: 16px; }
.cargo-heading { flex-direction: row; justify-content: space-between; align-items: center; }
.cargo-heading > .section-title { margin-top: 0; }
.capacity-text { font-size: 28px; color: var(--color-accent); }
.capacity-track { height: 8px; margin-bottom: 14px; background-color: var(--color-border); }
.capacity-fill { height: 100%; background-color: var(--color-action-hover); }
.capacity-fill.is-overloaded { background-color: var(--color-status-danger); }
.cargo-grid { flex-direction: row; flex-wrap: wrap; align-content: flex-start; }
.cargo-card { width: 48%; flex-shrink: 0; min-height: 328px; margin: 1%; padding: 14px; background-color: var(--color-hud-card); border-width: 0; border-bottom-width: var(--border-control-width); border-bottom-color: var(--color-border); border-radius: 0; }
.cargo-card-heading { flex-direction: row; }
.cargo-icon { width: 104px; height: 104px; margin-right: 12px; -unity-background-scale-mode: scale-to-fit; }
.cargo-card-copy { flex-grow: 1; flex-basis: 0; }
.cargo-name { font-size: 28px; white-space: normal; -unity-font-style: bold; }
.cargo-amount { font-size: 25px; color: var(--color-text-primary); }
.small-text { color: var(--color-text-secondary); font-size: 22px; white-space: normal; }
.cargo-rewards { min-height: 48px; font-size: 23px; color: var(--color-text-secondary); white-space: normal; margin: 8px 0; }
.cargo-actions { flex-direction: row; }
.cargo-actions > .harbor-button { flex-grow: 1; flex-basis: 0; height: 64px; min-height: 64px; padding: 6px; font-size: 24px; }
.cargo-empty { width: 23%; height: 140px; margin: 1%; font-size: 45px; min-height: 140px; flex-shrink: 0; }
.reward-preview { padding: 14px 12px; margin-bottom: 14px; flex-shrink: 0; background-color: transparent; border-radius: 0; }
.reward-heading { flex-direction: row; justify-content: space-between; align-items: center; margin: 0 8px 8px 8px; }
.reward-title { font-size: 27px; -unity-font-style: bold; }
.reward-heading > .small-text { font-size: 20px; }
.reward-currencies { flex-direction: row; }
.reward-currency { flex-grow: 1; flex-basis: 0; min-width: 0; padding: 8px; margin: 0 4px; border-width: 0; border-bottom-width: var(--border-control-width); border-bottom-color: transparent; border-radius: 0; }
.reward-name { font-size: 22px; color: var(--color-text-secondary); margin: 0; }
.reward-value { color: var(--color-accent); font-size: 36px; -unity-font-style: bold; margin: 4px 0 0 0; padding: 0; }
.reward-delta { height: 30px; font-size: 23px; -unity-font-style: bold; margin: 4px 0 0 0; padding: 0; opacity: 0; }
.reward-currency.is-gaining { border-color: var(--color-grade-uncommon); background-color: var(--color-surface-raised); }
.reward-currency.is-gaining > .reward-value { color: var(--color-text-primary); }
.reward-currency.is-gaining > .reward-delta { color: var(--color-grade-uncommon); }
.reward-currency.is-decreasing { border-color: var(--color-status-danger); }
.reward-currency.is-decreasing > .reward-delta { color: var(--color-status-danger); }
.cargo-screen > .status { min-height: 50px; }
.cargo-screen > .harbor-button { flex-shrink: 0; }

.cargo-slot, .cargo-empty { width: 23%; height: 140px; min-height: 140px; max-height: 140px; flex-shrink: 0; margin: 1%; }
.cargo-slot { padding: 6px 8px 32px 8px; border-width: var(--border-control-width); border-radius: 0; background-color: var(--color-surface-inset); }
.cargo-slot-icon { width: 100%; height: 100%; -unity-background-scale-mode: scale-to-fit; }
.cargo-slot-name { position: absolute; bottom: 4px; left: 4px; right: 4px; font-size: 21px; -unity-text-align: middle-center; margin: 0; padding: 0; }
.cargo-slot-amount { position: absolute; top: 4px; right: 4px; font-size: 22px; -unity-font-style: bold; background-color: var(--color-surface-primary); color: var(--color-accent); margin: 0; padding: 2px 6px; }
.cargo-slot-hint { font-size: 20px; margin: 0 0 8px 0; }
.cargo-detail-overlay { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: var(--color-surface-overlay); justify-content: center; padding: 36px; }
.cargo-detail-panel { background-color: var(--color-surface-primary); border-width: var(--border-control-width); border-color: var(--color-border); border-radius: 0; padding: 24px; }
.cargo-card.is-detail-card { width: 100%; margin: 0; min-height: 390px; background-color: transparent; border-width: 0; }
.is-detail-card .cargo-actions > .harbor-button { height: 80px; min-height: 80px; font-size: 28px; }
