.formation-comparison { flex-direction: row; height: 650px; flex-shrink: 0; }
.formation-side { flex-grow: 1; flex-basis: 0; min-width: 0; }
.side-title { font-size: 27px; margin-bottom: 12px; -unity-text-align: middle-center; }
.formation-columns { flex-direction: row; flex-grow: 1; min-height: 0; }
.formation-column { flex-grow: 1; flex-basis: 0; min-width: 0; margin: 3px; }
.column-title { -unity-text-align: middle-center; font-size: 24px; height: 38px; flex-shrink: 0; }
.formation-cells { flex-grow: 1; }
.formation-slot {
    flex-grow: 1; flex-basis: 0; min-height: 0; margin: 4px 0;
    padding: 6px;

}
.formation-slot .ship-icon { min-height: 20px; }
.formation-slot .ship-name { font-size: 22px; }
.formation-slot .ship-count { font-size: 20px; }
.comparison-arrow { width: 38px; flex-shrink: 0; -unity-text-align: middle-center;  font-size: 38px; }
.enemy-column {    padding: 8px; }
.enemy-marker { flex-grow: 1; flex-basis: 0; -unity-text-align: middle-center;  font-size: 32px; }
.attack-details {    padding: 16px; margin-top: 16px; flex-shrink: 0; }
.attack-name { font-size: 27px;  }
.attack-description { font-size: 23px; white-space: normal; margin-top: 8px; }
.fleet-controls { flex-direction: row; flex-shrink: 0; align-items: center; }
.fleet-controls > .subtitle { flex-grow: 1; margin-bottom: 0; }
.fleet-controls > .harbor-button { min-height: 60px; font-size: 23px; }

.fleet-controls > .subtitle { min-width: 0; -unity-text-align: middle-left; }
