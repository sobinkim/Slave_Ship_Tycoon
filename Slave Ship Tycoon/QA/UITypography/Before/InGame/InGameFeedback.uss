.feedback-root { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.stage-popup { position: absolute; left: 100px; right: 100px; top: 30%;  padding: 28px;    }
.popup-stage { font-size: 28px;  -unity-text-align: middle-center; }
.popup-result { font-size: 36px; white-space: normal;  -unity-text-align: middle-center; }
.settlement-card { height: 74%; padding: 28px;     }
.settlement-content { flex-grow: 1; flex-basis: 0; min-height: 0; }
.settlement-content > .unity-scroll-view__vertical-scroller { width: 12px; margin-left: 8px; }
.settlement-eyebrow { font-size: 26px;  -unity-text-align: middle-center; margin-bottom: 12px; }
.settlement-goal { padding: 20px; margin-bottom: 18px;      align-items: center; }
.settlement-goal-title { font-size: 27px;  white-space: normal; -unity-text-align: middle-center; }
.settlement-goal-amount { font-size: 64px;   margin-top: 8px; margin-bottom: 6px; }
.settlement-goal-caption { font-size: 24px;  }
.settlement-breakdown { margin-bottom: 22px; }
.settlement-breakdown-row { flex-direction: row; justify-content: space-between; padding: 5px 8px; }
.settlement-breakdown-row > Label { font-size: 25px;  }
.settlement-rewards-title {  font-size: 24px; margin-bottom: 10px; }
.settlement-reward { flex-direction: row; justify-content: space-between; align-items: center;  padding: 16px 20px; margin-bottom: 10px;     }
.settlement-reward-name { font-size: 27px; }
.reward-amount { font-size: 36px;   }
.settlement-status { font-size: 28px;   -unity-text-align: middle-center; margin-top: 8px; }
.settlement-growth-hint { flex-shrink: 0; font-size: 25px;  white-space: normal; -unity-text-align: middle-center; margin-top: 24px; }
.settlement-actions { margin-top: 10px; }
.settlement-close { flex-shrink: 0; margin-top: 8px; height: 68px; min-height: 68px;  }
.stage-fade { position: absolute; left: 0; right: 0; top: 0; bottom: 0;  }
